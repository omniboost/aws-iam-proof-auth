# Keep the Composer dist archive to the PHP package. Go modules are fetched
# from the repository itself and are not affected.
/.github            export-ignore
/acl                export-ignore
/cmd                export-ignore
/internal           export-ignore
/middleware         export-ignore
/valkeynonce        export-ignore
/testdata           export-ignore
/php/tests          export-ignore
/*.go               export-ignore
/go.mod             export-ignore
/go.sum             export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml.dist   export-ignore
